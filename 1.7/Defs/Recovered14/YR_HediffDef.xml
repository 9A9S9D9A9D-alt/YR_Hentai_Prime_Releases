<Defs>
  <HediffDef>
    <defName>YR_MilkingMachineAddon_Hediff</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>YR_MilkingMachineAddon_Hediff</label>
    <description>Milked by a milking machine.(A Hediff that goes through to check the body type and to give a hediff for the hediff add-on.)</description>
    <defaultLabelColor>(0.392, 0.678, 0.737)</defaultLabelColor>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>1</maxSeverity>
    <initialSeverity>1</initialSeverity>
    <isBad>false</isBad>
    <stages>
      <li>
        <becomeVisible>false</becomeVisible>
        <capMods>
          <li>
            <capacity>Manipulation</capacity>
            <setMax>0</setMax>
          </li>
          <li>
            <capacity>Moving</capacity>
            <setMax>0</setMax>
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.01</setMax>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="YR_RJW.HediffCompProperties_GiveDiffirenceHediff">
        <conditionAndHediffs>
          <li>
            <bedDefs>
              <li>YR_Building_MilkingMachine</li>
              <li>YR_Building_Tentacle</li>
            </bedDefs>
            <hediffDefs>
              <li>YR_SexNeedIncrease_Hediff</li>
            </hediffDefs>
          </li>
          <li>
            <bedDefs>
              <li>YR_Building_MilkingMachine</li>
            </bedDefs>
            <hediffDefs>
              <li>YR_Building_MilkingMachine_Hediff</li>
            </hediffDefs>
          </li>
          <li>
            <bedDefs>
              <li>YR_Building_Tentacle</li>
            </bedDefs>
            <hediffDefs>
              <li>YR_Building_Tentacle_Hediff</li>
            </hediffDefs>
          </li>
        </conditionAndHediffs>
      </li>
    </comps>
  </HediffDef>
