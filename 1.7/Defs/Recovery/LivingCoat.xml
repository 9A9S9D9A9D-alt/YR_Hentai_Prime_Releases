    <jobString>사목의 공생외투를 만드는 중.</jobString>
    <workAmount>2200</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <recipeUsers>
      <li>YR_SamokRefinery</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>YR_SamokTentacleRaw</li>
          </thingDefs>
        </filter>
        <count>180</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>YR_Baekgyojil</li>
          </thingDefs>
        </filter>
        <count>120</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>YR_PulsatingTissue</li>
          </thingDefs>
        </filter>
        <count>60</count>
