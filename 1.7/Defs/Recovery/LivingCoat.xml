<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ApparelNoQualityBase">
    <defName>YR_AP_LivingCoat</defName>
    <label>사목의 공생외투</label>
    <description>유란의 몸을 따라 감기는 자주색 생체 외투.</description>
    <generateCommonality>0</generateCommonality>
    <generateAllowChance>0</generateAllowChance>
    <tradeability>None</tradeability>
    <smeltable>false</smeltable>
    <thingCategories>
      <li>ApparelMisc</li>
    </thingCategories>
    <statBases>
      <Mass>1</Mass>
      <ArmorRating_Sharp>0.55</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.25</ArmorRating_Blunt>
      <ArmorRating_Heat>0.25</ArmorRating_Heat>
    </statBases>
    <comps>
      <li>
        <compClass>YuranLivingCoat.FixedModeComp</compClass>
      </li>
      <li>
        <compClass>YR_RJW.CompApparelScaleV45</compClass>
      </li>
    </comps>
    <graphicData>
      <texPath>YuranLivingCoat/Finished/Item</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <apparel>
      <wornGraphicPath>YuranLivingCoat/Finished/Coat</wornGraphicPath>
      <shellRenderedBehindHead>true</shellRenderedBehindHead>
      <developmentalStageFilter>Adult</developmentalStageFilter>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Waist</li>
        <li>Legs</li>
        <li>Shoulders</li>
        <li>Arms</li>
      </bodyPartGroups>
      <layers>
        <li>Shell</li>
      </layers>
      <drawData>
        <dataWest>
          <flip>true</flip>
        </dataWest>
      </drawData>
      <renderNodeProperties>
        <li>
          <debugLabel>Living coat front collar</debugLabel>
          <nodeClass>YuranLivingCoat.CollarNode</nodeClass>
          <workerClass>PawnRenderNodeWorker_Apparel_Body</workerClass>
          <parentTagDef>ApparelBody</parentTagDef>
          <baseLayer>55</baseLayer>
          <visibleFacing>
            <li>South</li>
          </visibleFacing>
        </li>
      </renderNodeProperties>
    </apparel>
  </ThingDef>
  <ThingDef ParentName="ApparelNoQualityBase">
    <defName>YR_AP_FixedModeHelmet</defName>
