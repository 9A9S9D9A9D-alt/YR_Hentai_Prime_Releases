  <HediffDef>
    <defName>YR_LivingCoatPenanceCoating</defName>
    <label>백윤액이 묻음</label>
    <description>참회의 방에서 나온 뒤 얼굴과 전신에 백윤액이 묻어 있다.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>600</disappearsAfterTicks>
      </li>
    </comps>
    <renderNodeProperties>
      <li>
        <nodeClass>YuranLivingCoat.PenanceCoating</nodeClass>
