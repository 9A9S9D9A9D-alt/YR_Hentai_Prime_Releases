        <baseLayer>105</baseLayer>
        <rotDrawMode>Fresh</rotDrawMode>
      </li>
    </renderNodeProperties>
  </HediffDef>
  <HediffDef>
    <defName>YR_LivingCoatAmpouleRegeneration</defName>
    <label>초재생 급속 앰플</label>
    <description>감염 면역 획득과 상처 회복 속도가 4배로 증가합니다.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>7500</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <ImmunityGainSpeed>4</ImmunityGainSpeed>
          <InjuryHealingFactor>4</InjuryHealingFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>YR_LivingCoatAmpouleCooldown</defName>
    <label>초재생 앰플 재투여 대기</label>
    <description>다음 초재생 급속 앰플을 투여할 수 있을 때까지 남은 시간입니다.</description>
