    <statBases>
      <Mass>0</Mass>
      <ArmorRating_Sharp>0.60</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.30</ArmorRating_Blunt>
      <ArmorRating_Heat>0.25</ArmorRating_Heat>
    </statBases>
    <graphicData>
      <texPath>YuranLivingCoat/FixedHelmet/Mask08_south</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <apparel>
      <bodyPartGroups>
        <li>FullHead</li>
      </bodyPartGroups>
      <layers>
        <li>Overhead</li>
      </layers>
      <renderSkipFlags>
        <li>None</li>
