<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>YR_HoodGrabPinned</defName>
    <label>목 잡기에 제압됨</label>
    <description>넘어뜨려져 잠시 움직일 수 없는 상태.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <initialSeverity>1</initialSeverity>
    <canApplyDodChanceForCapacityChanges>false</canApplyDodChanceForCapacityChanges>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>480</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li><capacity>Moving</capacity><setMax>0</setMax></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>YR_HoodGrabFullyPinned</defName>
    <label>완전제압</label>
    <description>완전제압 해제로 풀어줄 때까지 움직일 수 없는 상태.</description>
    <isBad>true</isBad>
    <initialSeverity>1</initialSeverity>
    <preventsCrawling>true</preventsCrawling>
    <canApplyDodChanceForCapacityChanges>false</canApplyDodChanceForCapacityChanges>
    <stages>
      <li>
        <capMods>
          <li><capacity>Moving</capacity><setMax>0</setMax></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
  <SoundDef>
    <defName>YR_HoodGrabPinLoop</defName>
    <sustain>true</sustain>
    <context>MapOnly</context>
    <subSounds>
      <li>
        <sustainLoop>true</sustainLoop>
        <muteWhenPaused>true</muteWhenPaused>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>HoodGrab/er1</clipPath>
          </li>
        </grains>
      </li>
    </subSounds>
  </SoundDef>
</Defs>
