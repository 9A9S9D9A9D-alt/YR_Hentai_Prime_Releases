      <texPath>Yuran/Things/Building/Furniture/LoveRoom/Bed/Texture</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1.5,1.5)</drawSize>
    </graphicData>
    <building>
      <bed_healPerDay>15</bed_healPerDay>
    </building>
