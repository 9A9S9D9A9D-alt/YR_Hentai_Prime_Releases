<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>YR_CoccyxTentacleImplant</defName>
    <label>촉수 이식체</label>
    <description>미추 접합부에 연결된 여섯 가닥의 유연한 촉수. 끝은 둥글며, 집결하면 길게 뻗어 위협적인 자세를 취한다. 이식한 동안 조작 능력이 20%p 증가한다.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages><li><capMods><li><capacity>Manipulation</capacity><offset>0.2</offset></li></capMods></li></stages>
    <comps><li Class="YR_RJW.HediffCompProperties_CoccyxCombat" /></comps>
    <renderNodeProperties>
      <li>
        <nodeClass>YR_RJW.PawnRenderNode_CoccyxTentacles</nodeClass>
        <workerClass>YR_RJW.PawnRenderNodeWorker_CoccyxTentacles</workerClass>
        <parentTagDef>Body</parentTagDef>
        <texPath>Yuran/Implants/CoccyxTentacles/Idle</texPath>
        <drawSize>(2.6,2.6)</drawSize>
        <baseLayer>10</baseLayer>
        <color>(1,1,1,1)</color>
        <shaderTypeDef>Cutout</shaderTypeDef>
      </li>
    </renderNodeProperties>
  </HediffDef>
</Defs>
