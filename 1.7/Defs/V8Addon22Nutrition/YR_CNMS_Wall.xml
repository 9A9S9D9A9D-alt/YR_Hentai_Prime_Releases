<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>YR_CNMS_Wall</defName>
    <label>CNMS(wall)</label>
    <description>CNMS stands for the Central Nutrition Management System, which automatically nourishes those bound to the surrounding compatible furniture by inserting a nutrition pack into the device.\n\nProducts collected from the milking machine within a certain range are automatically accumulated in this device. If more than a certain amount is collected, it automatically discharged, and all the contents can be discharged manually.\n\nWhen a particular CNMS is designated as the main system, all the products gathered in the other CNMS are accumulated in the main system. In addition, when CNMS is installed in a prison, the products collected in this device are automatically moved and accumulated to CNMS that exist outside of the prison.</description>
    <uiOrder>3525</uiOrder>
    <descriptionHyperlinks>
      <ThingDef>YR_NutritionPack</ThingDef>
    </descriptionHyperlinks>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
    <designationCategory>YR_RJW_Furniture</designationCategory>
    <minifiedDef>MinifiedThing</minifiedDef>
    <graphicData>
      <shaderType>CutoutComplex</shaderType>
      <texPath>Yuran/Things/Building/Furniture/CNMS_Wall/Texture</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <tickerType>Normal</tickerType>
    <rotatable>false</rotatable>
    <defaultPlacingRot>South</defaultPlacingRot>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <blockWind>true</blockWind>
    <blockLight>true</blockLight>
    <fillPercent>1</fillPercent>
    <castEdgeShadows>true</castEdgeShadows>
    <pathCost>42</pathCost>
    <costList>
      <ComponentIndustrial>3</ComponentIndustrial>
      <Steel>100</Steel>
    </costList>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <Mass>15</Mass>
      <WorkToBuild>2000</WorkToBuild>
      <Flammability>1.0</Flammability>
      <Beauty>5</Beauty>
    </statBases>
    <size>(1,1)</size>
    <staticSunShadowHeight>0.5</staticSunShadowHeight>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>ComplexFurniture</li>
    </researchPrerequisites>
    <socialPropernessMatters>true</socialPropernessMatters>
    <uiIconScale>0.75</uiIconScale>
    <coversFloor>true</coversFloor>
    <comps>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>false</shortCircuitInRain>
        <basePowerConsumption>80</basePowerConsumption>
      </li>
      <li Class="CompProperties_Facility">
        <maxSimultaneous>1</maxSimultaneous>
        <maxDistance>6</maxDistance>
      </li>
      <li Class="YR_RJW.CompProperties_CNMS">
        <showMessageIfOwned>true</showMessageIfOwned>
        <stackLimit>50</stackLimit>
        <!-- 연료 1당 허기 채워지는 양-->
        <!-- 일반 식재료 0.05-->
        <!-- 식재료 10개 0.5 - 간단한 식사 0.9-->
        <!-- 식재료 6개 0.3 - 영양죽 0.9-->
        <!-- 식재료 40개 2.0 - 영양팩 6/4=1.5-->
        <nutrition>0.09</nutrition>
        <anotherCNMSDefnames>
          <li>YR_CNMS</li>
          <li>YR_CNMS_Wall</li>
          <li>YR_Tentacle_CNMS</li>
        </anotherCNMSDefnames>
      </li>
      <li Class="CompProperties_Refuelable">
        <fuelLabel>stored nutrition</fuelLabel>
        <fuelGizmoLabel>nutrition</fuelGizmoLabel>
        <outOfFuelMessage>stored nutrition exhausted</outOfFuelMessage>
        <fuelFilter>
          <thingDefs>
            <li>YR_NutritionPack</li>
          </thingDefs>
        </fuelFilter>
        <fuelCapacity>500</fuelCapacity>
        <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
        <initialConfigurableTargetFuelLevel>250</initialConfigurableTargetFuelLevel>
        <autoRefuelPercent>0.2</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <fuelIconPath>Yuran/Things/Item/Resource/YR_NutritionPack</fuelIconPath>
      </li>
    </comps>
  </ThingDef>
</Defs>