<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Bori race</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName = "Alien_SP"]/alienRace/graphicPaths/apparel</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName = "Alien_SP"]/alienRace/graphicPaths</xpath>
            <value>
              <apparel />
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName = "Alien_SP"]/alienRace/graphicPaths/apparel/individualPaths</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName = "Alien_SP"]/alienRace/graphicPaths/apparel</xpath>
            <value>
              <individualPaths />
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName = "Alien_SP"]/alienRace/graphicPaths/apparel/individualPaths</xpath>
          <match Class="PatchOperationAdd">
            <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName = "Alien_SP"]/alienRace/graphicPaths/apparel/individualPaths</xpath>
            <value>
              <li>
                <key>YR_AP_Tentacle</key>
                <value>Yuran/Yuranlike/Apparel/Bote/YR_AP_Tentacle/Sheepawm/Texture</value>
              </li>
              <li>
                <key>YR_AP_Tentacle_Headgear</key>
                <value>Yuran/Yuranlike/Apparel/Bote/YR_AP_Tentacle_Headgear/Mincho/Texture</value>
              </li>
              <li>
                <key>YR_AP_Tentacle_Headgear_Mask</key>
                <value>Yuran/Yuranlike/Apparel/Bote/YR_AP_Tentacle_Headgear_Mask/Mincho/Texture</value>
              </li>
            </value>
          </match>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>