<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Mincho, The Mint Choco Slime ~ HAR ver.</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/HediffDef[defName = "Pregnant"]/comps</xpath>
          <value>
            <li MayRequire="SutSutMan.MinchoTheMintChocoSlimeHARver" Class="ChangeLook.HediffCompProperties_ChangeLook">
              <severity>0.5</severity>
            </li>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName = "Mincho_ThingDef"]/alienRace/graphicPaths/apparel/individualPaths</xpath>
          <value>
            <li>
              <key>YR_AP_Tentacle_Headgear</key>
              <value>Yuran/Yuranlike/Apparel/Bote/YR_AP_Tentacle_Headgear/Mincho/Texture</value>
            </li>
            <li>
              <key>YR_AP_Tentacle_Headgear_Mask</key>
              <value>Yuran/Yuranlike/Apparel/Bote/YR_AP_Tentacle_Headgear_Mask/Mincho/Texture</value>
            </li>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>