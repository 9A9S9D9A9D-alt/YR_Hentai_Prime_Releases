    <success>Always</success>
    <mods>
      <li>LittleFairy the Those Who Seek Flesh and Blood Race</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationTest">
          <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="LittleFairy_Pawn"]/alienRace/graphicPaths/apparel</xpath>
          <success>Invert</success>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="LittleFairy_Pawn"]/alienRace/graphicPaths</xpath>
          <value>
            <apparel>
            </apparel>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
